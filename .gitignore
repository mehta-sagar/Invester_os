# data never goes to GitHub: bytes live in data/, facts about bytes live in data/manifests and the ledgers (tracked)
data/raw/*
!data/raw/.gitkeep
data/staged/*
!data/staged/.gitkeep
data/canonical/*
!data/canonical/.gitkeep
data/features/*
!data/features/.gitkeep
data/models/*
!data/models/.gitkeep
data/quarantine/*
!data/quarantine/.gitkeep
data/exports/*
!data/exports/.gitkeep
# runtime artefacts (never commit)
*.lock
.tmp-*
*.tmp
reports/checks/*
.env
credentials/
__pycache__/
*.pyc
.venv/
.DS_Store
# collector state (limiter stamps, daily counters): machine state, never committed
data/ledger/.state/
